{
  "name": "kora",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @kora/db generate",
    "db:migrate": "pnpm --filter @kora/db migrate",
    "db:studio": "pnpm --filter @kora/db studio",
    "etl:users": "pnpm --filter @kora/etl users",
    "etl:verify": "pnpm --filter @kora/etl verify",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  }
}
