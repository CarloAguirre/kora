{
  "name": "@kora/db",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seeds/run.ts",
    "seed:demo": "tsx src/seeds/run-demo.ts",
    "seed:demo-amicar": "tsx src/seeds/run-demo-amicar.ts",
    "seed:demo-support-billing": "tsx src/seeds/run-demo-support-billing.ts",
    "seed:aurelia-spr": "tsx src/seeds/run-aurelia-spr.ts",
    "seed:aurelia-inspecciones": "tsx src/seeds/run-aurelia-inspecciones.ts",
    "seed:aurelia-incidentes": "tsx src/seeds/run-aurelia-incidentes.ts",
    "seed:aurelia-controles-criticos": "tsx src/seeds/run-aurelia-controles-criticos.ts",
    "seed:aurelia-sustancias-peligrosas": "tsx src/seeds/run-aurelia-sustancias-peligrosas.ts",
    "seed:aurelia-gestion-documental": "tsx src/seeds/run-aurelia-gestion-documental.ts",
    "seed:aurelia-capacitaciones-ambientales": "tsx src/seeds/run-aurelia-capacitaciones-ambientales.ts",
    "seed:aurelia-monitoreo-de-aire": "tsx src/seeds/run-aurelia-monitoreo-de-aire.ts",
    "seed:aurelia-monitoreo-de-agua": "tsx src/seeds/run-aurelia-monitoreo-de-agua.ts",
    "seed:aurelia-agentes": "tsx src/seeds/run-aurelia-agentes.ts",
    "backfill:slugs": "tsx src/backfill-slugs.ts",
    "backfill:ticket-hh-request-hour-entries": "tsx src/backfill-ticket-hh-request-hour-entries.ts",
    "backfill:support-plan-container-projects": "tsx src/backfill-support-plan-container-projects.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "@kora/contracts": "workspace:*"
  },
  "devDependencies": {
    "@kora/config": "workspace:*",
    "@types/node": "^22.16.5",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "5.9.3"
  }
}