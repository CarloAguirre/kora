NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://postgres:1234@localhost:5432/kora2
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-verdad
JWT_REFRESH_SECRET=y-esto-por-otro-distinto-igual-de-largo-y-aleatorio
