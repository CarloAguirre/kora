NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://postgres:1234@localhost:5432/kora2
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-verdad
JWT_REFRESH_SECRET=y-esto-por-otro-distinto-igual-de-largo-y-aleatorio
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Dominios de correo autorizados para iniciar sesión (vacío = todos)
ALLOWED_EMAIL_DOMAINS=kabeli.cl

# Correo saliente (Resend, dominio verificado kora.kabeli.cl). Sin RESEND_API_KEY
# los correos se escriben en el log en vez de enviarse; en producción es obligatoria.
RESEND_API_KEY=
MAIL_FROM=Kora <avisos@kora.kabeli.cl>
# Solo desarrollo: desvía todos los correos a tu buzón para no escribirle a
# usuarios reales de la base local.
# MAIL_REDIRECT_TO=tu.nombre@kabeli.cl
# URL pública del front (los enlaces de los correos son absolutos).
WEB_APP_URL=http://localhost:5173
# Recordatorios diarios de horas (18:00 sin registrar / 08:00 por aprobar, hora
# de Chile). Solo en producción: en local le escribiría a usuarios reales.
# HOUR_REMINDERS_ENABLED=true

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

LOG_LEVEL=debug
